<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="com.example.erp.frontend.crm.CrmOverviewView" %><%@ page import="com.example.erp.frontend.crm.CrmOverviewView.LeadView" %>
<!doctype html><html lang="cs"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>ERP | CRM</title><link rel="stylesheet" href="assets/base.css"><link rel="stylesheet" href="assets/crm.css"></head><body><main class="crm-page"><header class="crm-header"><a href="apps" class="back-link">← Aplikace</a><div><span class="eyebrow">OBCHOD / CRM</span><h1>CRM</h1><p>Řiďte obchodní příležitosti od prvního kontaktu po uzavřený obchod.</p></div><a href="#leads" class="primary">Přehled příležitostí</a></header><% CrmOverviewView overview = (CrmOverviewView) request.getAttribute("overview"); String error = (String) request.getAttribute("error"); String message = request.getParameter("message"); if (error != null) { %><p class="crm-message error"><%= error %></p><% } if (message != null) { %><p class="crm-message"><%= message %></p><% } %><section class="crm-metrics"><article><span>Hodnota pipeline</span><strong><%= overview == null ? "-" : overview.pipeline() %> Kč</strong><small>všechny příležitosti</small></article><article><span>Vážený forecast</span><strong><%= overview == null ? "-" : overview.forecast() %> Kč</strong><small>podle pravděpodobnosti</small></article><article><span>Otevřené příležitosti</span><strong><%= overview == null ? "-" : overview.openLeadCount() %></strong><small>v aktivní pipeline</small></article></section><section id="leads"><div class="section-head"><div><span class="eyebrow">OBCHODNÍ PIPELINE</span><h2>Příležitosti</h2></div></div><div class="lead-list"><% if (overview != null) for (LeadView lead : overview.leads()) { %><article class="lead-card"><div><span class="stage stage-<%= lead.stage().toLowerCase() %>"><%= lead.stage() %></span><h3><%= lead.name() %></h3><p><%= lead.customerName() %></p></div><dl><div><dt>Hodnota</dt><dd><%= lead.expectedRevenue() %> Kč</dd></div><div><dt>Pravděpodobnost</dt><dd><%= lead.probability() %> %</dd></div><div><dt>Uzavření</dt><dd><%= lead.expectedCloseDate() %></dd></div></dl><% if (!"WON".equals(lead.stage())) { %><form method="post"><input type="hidden" name="id" value="<%= lead.id() %>"><button class="secondary">Označit jako vyhranou</button></form><% } else { %><span class="won-label">Vyhráno</span><% } %></article><% } %></div></section></main></body></html>