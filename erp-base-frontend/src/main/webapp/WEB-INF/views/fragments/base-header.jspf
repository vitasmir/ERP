<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<!doctype html>
<html lang="cs"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>ERP | ${pageTitle}</title><link rel="stylesheet" href="assets/base.css"><style>.topbar .breadcrumb{display:none !important}.logout-form{margin:0}.logout-button{border:1px solid #dddcd2;background:#faf9f5;border-radius:5px;color:#526c5a;padding:10px 12px;font:11px 'Space Grotesk';cursor:pointer}.logout-button:hover{background:#dce9d7;color:#17362b}</style></head>
<body><div class="app-shell"><aside class="sidebar"><div class="brand"><span class="mark">E</span><div><strong>ERP CORE</strong><small>base module</small></div></div><div class="workspace-label">WORKSPACE</div><nav><a class="nav-item ${activePage == 'apps' ? 'active' : ''}" href="apps"><span>⌂</span> Přehled</a><a class="nav-item ${activePage == 'users' ? 'active' : ''}" href="users"><span>♙</span> Uživatelé</a><a class="nav-item ${activePage == 'roles' ? 'active' : ''}" href="roles"><span>◈</span> Role a oprávnění</a><a class="nav-item ${activePage == 'role-modules' ? 'active' : ''}" href="role-modules"><span>▤</span> Role pro moduly</a><a class="nav-item ${activePage == 'companies' ? 'active' : ''}" href="companies"><span>▦</span> Společnosti</a><a class="nav-item ${activePage == 'settings' ? 'active' : ''}" href="settings"><span>⚙</span> Nastavení</a></nav><div class="sidebar-bottom"><span class="online"></span> Systém je online<small>PostgreSQL 18 · lokální režim</small></div></aside><main class="main"><header class="topbar"><div><p class="breadcrumb">${breadcrumb}</p></div><div class="top-actions"><button class="search" aria-label="Hledat">⌕ <span>Hledat</span></button><button class="bell" aria-label="Oznámení">♧<i></i></button><div class="profile"><span class="avatar">JK</span><span><b>Jan Král</b><small>Administrátor</small></span><span>⌄</span></div><form method="post" action="logout" class="logout-form"><button class="logout-button" type="submit">Odhlásit se</button></form></div></header>