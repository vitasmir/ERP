<%@ page contentType="text/html" pageEncoding="UTF-8" %>
<%@ page import="com.example.erp.frontend.shop.ShopView" %>
<%@ page import="com.example.erp.frontend.shop.ShopView.Category" %>
<%@ page import="com.example.erp.frontend.shop.ShopView.CategoryOption" %>
<%@ page import="com.example.erp.frontend.shop.ShopView.Product" %>
<%@ page import="com.example.erp.frontend.shop.ShopView.CartLine" %>
<!doctype html>
<html lang="cs">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Fresh Market | E-shop</title><link rel="stylesheet" href="assets/shop.css">
  <style>@media(min-width:1200px){.shop-products{grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.shop-product{padding:12px;grid-template-columns:74px 1fr;gap:10px;min-height:220px}.shop-product-image,.product-placeholder{width:74px;height:100px}.product-info h3{font-size:15px}.product-info p{font-size:10px}.product-buy{gap:7px;flex-wrap:wrap}.product-buy strong{font-size:17px}.stock-label{width:100%;margin-right:0}.product-buy form{width:100%}.add-button{width:100%}}</style>
</head>
<body>
<% ShopView shop = (ShopView) request.getAttribute("shop"); String error = request.getParameter("error"); boolean orderCompleted = "completed".equals(request.getParameter("order")); String categoryInput = shop != null && shop.selectedCategoryId() != null ? "<input type=\"hidden\" name=\"categoryId\" value=\"" + shop.selectedCategoryId() + "\">" : ""; %>
<header class="shop-header"><a class="shop-brand" href="eshop"><span class="brand-mark">F</span><span><strong>FRESH MARKET</strong><small>lokální nákup bez čekání</small></span></a><nav><a href="#catalog">Katalog</a><a href="#delivery">Doručení</a><a class="admin-link" href="ecommerce">Administrace</a></nav><a class="cart-jump" href="#cart">Košík <b><%= shop == null ? 0 : shop.cartCount() %></b></a></header>
<main class="shop-shell">
  <% if (error != null) { %><p class="shop-error"><%= error %></p><% } %>
  <% if (shop == null) { %><section class="shop-error">Katalog se nepodařilo načíst.</section><% } else { %>
  <section class="shop-hero"><div><span class="kicker">DNEŠNÍ VÝBĚR</span><h1>Dobré věci<br><em>na dosah ruky.</em></h1><p>Čerstvé produkty z vašich oblíbených prodejen. Vyberte kategorii, sestavte košík a zvolte způsob doručení.</p><a class="hero-button" href="#catalog">Prohlédnout nabídku <span>↓</span></a></div><div class="hero-stamp"><strong>24 h</strong><span>rychlé doručení<br>domů nebo do boxu</span></div></section>
  <section class="store-layout" id="catalog">
    <aside class="category-nav"><div class="eyebrow">KATALOG</div><h2>Co hledáte?</h2><a class="category-filter <%= shop.selectedCategoryId() == null ? "active" : "" %>" href="eshop">Všechny produkty <span><%= shop.totalProductCount() %></span></a><% for (CategoryOption option : shop.categoryOptions()) { %><a class="category-filter <%= option.id().equals(shop.selectedCategoryId()) ? "active" : "" %>" style="padding-left:<%= 14 + option.depth() * 16 %>px" href="eshop?categoryId=<%= option.id() %>"><%= option.name() %></a><% } %><div class="category-note" id="delivery"><strong>Doručení podle vás</strong><p>Domů od zítřka<br>Box od pozítří</p></div></aside>
    <section class="catalog-area"><div class="catalog-heading"><div><span class="eyebrow">FRESH / LOCAL / TODAY</span><h2>Produkty pro každý den</h2></div><span class="result-count" id="result-count"><%= shop.products().size() %> produktů</span></div><div class="shop-products"><% for (Product product : shop.products()) { %><article class="shop-product" data-product-card data-category-id="<%= product.categoryId() == null ? "uncategorized" : product.categoryId() %>"><% if (product.imageUrl() != null && !product.imageUrl().isBlank()) { %><img class="shop-product-image" src="<%= product.imageUrl() %>" alt="<%= product.name() %>"><% } else { %><div class="product-placeholder"><span>FM</span></div><% } %><div class="product-info"><span class="product-sku"><%= product.sku() %></span><h3><%= product.name() %></h3><p><%= product.description() %></p></div><div class="product-buy"><div><strong><%= product.price() %> Kč</strong><small>/ <%= product.unit() %></small></div><span class="stock-label"><%= product.availableQuantity() %> <%= product.unit() %> skladem</span><form method="post"><%= categoryInput %><input type="hidden" name="action" value="add"><input type="hidden" name="productId" value="<%= product.id() %>"><input type="hidden" name="quantity" value="1"><button class="add-button" type="submit" <%= product.availableQuantity() <= 0 ? "disabled" : "" %>><%= product.availableQuantity() <= 0 ? "Vyprodáno" : "Přidat do košíku" %> <span>+</span></button></form></div></article><% } %></div><p class="empty-products" id="empty-products" style="display:<%= shop.products().isEmpty() ? "block" : "none" %>">V této kategorii zatím nejsou žádné produkty.</p></section>
  </section>
  <aside class="cart-panel" id="cart"><div class="cart-heading"><div><span class="eyebrow">VÁŠ NÁKUP</span><h2>Košík</h2></div><span class="cart-count"><%= shop.cartCount() %> ks</span></div><% if (shop.cart().isEmpty()) { %><div class="empty-cart"><span>○</span><h3>Košík čeká na svůj první nákup.</h3><p>Vyberte produkt v katalogu a počet kusů upravíte přímo tady.</p></div><% } else { %><div class="cart-lines"><% for (CartLine line : shop.cart()) { %><article class="cart-line"><div class="cart-product-thumb"><% if (line.product().imageUrl() != null && !line.product().imageUrl().isBlank()) { %><img class="cart-product-image" src="<%= line.product().imageUrl() %>" alt="<%= line.product().name() %>"><% } else { %><div class="cart-product-placeholder" aria-hidden="true">FM</div><% } %></div><div class="cart-line-main"><strong><%= line.product().name() %></strong><small><%= line.product().price() %> Kč / <%= line.product().unit() %></small></div><div class="quantity-control"><form method="post"><%= categoryInput %><input type="hidden" name="action" value="decrease"><input type="hidden" name="productId" value="<%= line.product().id() %>"><button aria-label="Odebrat jeden kus">−</button></form><form method="post"><%= categoryInput %><input type="hidden" name="action" value="set"><input type="hidden" name="productId" value="<%= line.product().id() %>"><input name="quantity" value="<%= line.quantity() %>" min="1" max="<%= line.product().availableQuantity() %>" type="number" aria-label="Počet kusů"></form><form method="post"><%= categoryInput %><input type="hidden" name="action" value="increase"><input type="hidden" name="productId" value="<%= line.product().id() %>"><button aria-label="Přidat jeden kus">+</button></form></div><strong class="line-total"><%= line.lineTotal() %> Kč</strong><form method="post" class="remove-line"><%= categoryInput %><input type="hidden" name="action" value="remove"><input type="hidden" name="productId" value="<%= line.product().id() %>"><button aria-label="Odstranit produkt z košíku">×</button></form></article><% } %></div><div class="cart-summary"><span>Celkem</span><strong><%= shop.cartTotal() %> Kč</strong></div><button class="checkout-button" type="button">Pokračovat k doručení <span>→</span></button><p class="checkout-note">Objednávku dokončíte v dalším kroku.</p><% } %></aside>
  <% } %>
</main><% if (orderCompleted) { %><section class="order-complete-dialog" role="dialog" aria-modal="true" aria-labelledby="order-complete-heading"><div><span class="order-complete-mark">✓</span><span class="eyebrow">OBJEDNÁVKA</span><h2 id="order-complete-heading">Objednávka byla úspěšně dokončena</h2><p>Děkujeme za váš nákup. Vracíme vás na úvodní stránku e-shopu.</p><a class="checkout-submit" href="eshop">Pokračovat do e-shopu <span>→</span></a></div></section><% } %><% if (shop != null && shop.checkoutOpen() && !shop.cart().isEmpty()) { %><section id="delivery-step" class="delivery-step"><div class="delivery-step-heading"><span class="eyebrow">DORUČENÍ</span><h2>Adresa zákazníka</h2><p>Vyplňte údaje, na které má být nákup doručen.</p></div><form method="post" class="delivery-form"><input type="hidden" name="action" value="delivery"><label>Jméno<input name="firstName" value="" autocomplete="given-name" required></label><label>Příjmení<input name="lastName" value="" autocomplete="family-name" required></label><label>Telefon<input name="phone" type="tel" value="" placeholder="+420 123 456 789" autocomplete="tel" required></label><label>Ulice a číslo domu<input name="street" value="" autocomplete="street-address" required></label><label>Město<input name="city" value="" autocomplete="address-level2" required></label><label>PSČ<input name="postalCode" value="" placeholder="602 00" pattern="[0-9]{3} ?[0-9]{2}" autocomplete="postal-code" required></label><button class="checkout-submit" type="submit">Pokračovat k platbě <span>→</span></button></form></section><% } else if (shop != null && shop.paymentOpen() && !shop.cart().isEmpty()) { %><section id="payment-step" class="delivery-step payment-step" role="dialog" aria-labelledby="payment-heading"><div class="delivery-step-heading"><span class="eyebrow">PLATBA</span><h2 id="payment-heading">Platební údaje</h2><p>Zvolte způsob úhrady objednávky.</p></div><form method="post" class="payment-options" data-subtotal="<%= shop.cartTotal() %>" data-delivery-fee="<%= shop.deliveryFee() %>"><input type="hidden" name="action" value="payment"><div class="payment-methods"><label class="payment-option"><input type="radio" name="paymentMethod" value="card" checked required><span><strong>VISA / MasterCard</strong><small>Platba kartou online</small></span></label><label class="payment-option"><input type="radio" name="paymentMethod" value="cod"><span><strong>Platba při doručení</strong><small>Uhradíte kurýrovi při převzetí</small></span></label></div><div class="card-details" data-card-details><label>Číslo karty<span class="card-number-fields"><input name="cardNumber1" inputmode="numeric" autocomplete="cc-number" maxlength="4" pattern="[0-9]{4}" placeholder="1234"><input name="cardNumber2" inputmode="numeric" maxlength="4" pattern="[0-9]{4}" placeholder="5678"><input name="cardNumber3" inputmode="numeric" maxlength="4" pattern="[0-9]{4}" placeholder="9012"><input name="cardNumber4" inputmode="numeric" maxlength="4" pattern="[0-9]{4}" placeholder="3456"></span></label><label>Platnost<input name="cardExpiry" inputmode="numeric" autocomplete="cc-exp" placeholder="MM/RR"></label><label>CVV<input name="cardCvc" inputmode="numeric" autocomplete="cc-csc" placeholder="123"></label></div><div class="payment-summary"><span>Mezisoučet</span><strong><%= shop.cartTotal() %> Kč</strong><span data-delivery-fee-label hidden>Poplatek za doručení</span><strong data-delivery-fee-label hidden><%= shop.deliveryFee() %> Kč</strong><span>Celkem</span><strong data-payment-total><%= shop.cartTotal() %> Kč</strong></div><button class="checkout-submit" type="submit">Dokončit objednávku <span>→</span></button></form></section><% } %><script src="assets/shop.js"></script>
</body></html>
