<!doctype html>
<html lang="cs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>ERP | Přihlášení</title>
    <link rel="stylesheet" href="{{ asset('assets/base.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/workflows.css') }}">
    <link rel="stylesheet" href="/compatibility.css?v=1">
</head>
<body>
<main class="login-page">
    <a href="/eshop">E-shop</a>
    <h1>Retail ERP</h1>
    {% if error %}<p role="alert">{{ error }}</p>{% endif %}
    <form method="post" action="{{ path('app_login') }}" class="workflow-fields">
        <label>Uživatelské jméno<input name="username" required maxlength="120" autocomplete="username"></label>
        <label>Heslo<input name="password" type="password" required autocomplete="current-password"></label>
        <button type="submit" class="primary">Přihlásit se</button>
    </form>
    {% if authenticated %}
        <form method="post" action="{{ path('app_logout') }}"><button type="submit">Odhlásit se</button></form>
    {% endif %}
</main>
</body>
</html>
