{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('assets/website.css') }}">
{% endblock %}

{% block body %}
<div class="website-page">
    {% if error %}<p class="website-message error" role="alert">{{ error }}</p>{% endif %}
    {% if page %}
    <header class="website-header"><div><span class="eyebrow">WEB</span><h1>{{ page.title }}</h1></div></header>
    <section class="website-section">{{ (page.content ?? '')|raw }}</section>
    {% endif %}
</div>
{% endblock %}
